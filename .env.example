# Wishbone Golf — Shopify credentials
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# The store. Do not change unless Shopify renames it.
SHOP=k500sw-e1.myshopify.com

# Theme Access token (starts with shptka_). Created by installing the free
# "Theme Access" app in Shopify admin and issuing a password for this machine.
# This is the only credential theme work needs. See docs/SETUP.md step 1.
SHOPIFY_CLI_THEME_TOKEN=shptka_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Live theme ID, for reference only — bin/wb always resolves it live.
THEME_ID_LIVE=187794981188

# --- optional, only if this project grows Admin API scripts ----------------
# (catalog, metafields, orders). Needs a separate custom app in Shopify admin;
# a Theme Access token cannot do these. Check the current stable API version in
# Shopify's docs before setting it.
# ADMIN_API_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_API_VERSION=
