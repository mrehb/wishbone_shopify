# Wishbone Golf — Shopify credentials
# Copy to .env and fill in. .env is git-ignored and must never be committed.

SHOP=k500sw-e1.myshopify.com

# Dev Dashboard app, client-credentials grant. Tokens last 24h and are minted on
# demand by scripts/token.mjs, cached in .shopify-token.json (also git-ignored).
CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Live theme ID, for reference — bin/wb always resolves it live.
THEME_ID_LIVE=187794981188

# Alternative to the pair above: a static Theme Access password (shptka_…).
# If set and not a placeholder, it wins over the client credentials.
# SHOPIFY_CLI_THEME_TOKEN=

# --- optional, only if this project grows catalog/metafield scripts ---------
# The current app is scoped to themes only. Products, orders and metafields
# need scopes added to the app (or a second app) — check before assuming.
# SHOPIFY_API_VERSION=
