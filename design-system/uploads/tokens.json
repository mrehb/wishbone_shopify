{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Wishbone Golf brand tokens, derived from the live Shopify theme 2026-09-19. Source of truth: BRAND_KIT.md",
  "color": {
    "ink":   { "$type": "color", "$value": "#1F1F21", "$description": "The ground. Default background of the brand." },
    "white": { "$type": "color", "$value": "#FFFFFF", "$description": "Type and marks on ink." },
    "volt":  { "$type": "color", "$value": "#E3FC02", "$description": "Action colour. Carries ink type only." },
    "cyan":  { "$type": "color", "$value": "#00FCED", "$description": "Secondary accent panel. Carries ink type only." },
    "logo-lime": { "$type": "color", "$value": "#C8D645", "$description": "Monogram accent as shipped — conflicts with volt, decision pending." }
  },
  "font": {
    "heading": { "$type": "fontFamily", "$value": ["Oswald", "Arial Narrow", "sans-serif"] },
    "body":    { "$type": "fontFamily", "$value": ["Figtree", "-apple-system", "sans-serif"] }
  },
  "fontWeight": {
    "heading": { "$type": "fontWeight", "$value": 500 },
    "body":    { "$type": "fontWeight", "$value": 500 },
    "bold":    { "$type": "fontWeight", "$value": 700 }
  },
  "fontSize": {
    "display":  { "$type": "dimension", "$value": "72.8px" },
    "h1":       { "$type": "dimension", "$value": "56px" },
    "h1-mobile":{ "$type": "dimension", "$value": "42px" },
    "h2":       { "$type": "dimension", "$value": "33.6px" },
    "h2-mobile":{ "$type": "dimension", "$value": "28px" },
    "h3":       { "$type": "dimension", "$value": "25.2px" },
    "h4":       { "$type": "dimension", "$value": "21px" },
    "h5":       { "$type": "dimension", "$value": "18.2px" },
    "body":     { "$type": "dimension", "$value": "15px" },
    "caption":  { "$type": "dimension", "$value": "11px" }
  },
  "letterSpacing": {
    "caption": { "$type": "dimension", "$value": "0.13rem" },
    "eyebrow": { "$type": "dimension", "$value": "0.16rem" }
  },
  "radius": {
    "default":      { "$type": "dimension", "$value": "0px", "$description": "Buttons, cards, inputs, media — everything is square." },
    "variant-pill": { "$type": "dimension", "$value": "40px", "$description": "The single deliberate exception." }
  },
  "border": {
    "width":   { "$type": "dimension", "$value": "1px" },
    "opacity": { "$type": "number", "$value": 0.55 }
  },
  "shadow": {
    "none": { "$type": "shadow", "$value": "none", "$description": "The brand has no shadows. Opacity is 0 on every theme surface." }
  },
  "space": {
    "page-width":     { "$type": "dimension", "$value": "1600px" },
    "section":        { "$type": "dimension", "$value": "52px" },
    "grid-horizontal":{ "$type": "dimension", "$value": "40px" },
    "grid-vertical":  { "$type": "dimension", "$value": "40px" }
  }
}
