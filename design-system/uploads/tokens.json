{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Wishbone Golf v3 'Instrument' tokens, 2026-09-19. Rebuilt from the references; supersedes v2.",
  "color": {
    "ground": {
      "$type": "color",
      "$value": "#0F1014"
    },
    "tile": {
      "$type": "color",
      "$value": "#111214"
    },
    "lime": {
      "$type": "color",
      "$value": "#A8FF4A",
      "$description": "The only accent. Hue 89\u00b0 \u2014 the hardware's green. Always carries ground-coloured text."
    },
    "white": {
      "$type": "color",
      "$value": "#FAFAFA"
    },
    "grey": {
      "$type": "color",
      "$value": "#8E9298"
    },
    "light": {
      "$type": "color",
      "$value": "#F2D2AB",
      "$description": "The lamp. Gradient value only, never a fill."
    }
  },
  "retired": {
    "volt": {
      "$value": "#E3FC02",
      "$description": "v1/v2 accent \u2014 hue 66\u00b0, a yellow-green; retired for the hardware's true green"
    },
    "cyan": {
      "$value": "#00FCED"
    },
    "error-red": {
      "$value": "#FF6B6B",
      "$description": "v2. There is no red in v3; attention is lime."
    },
    "carbon-card": {
      "$value": "#16171B"
    },
    "raised": {
      "$value": "#1E2026"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": [
        "DotGothic16",
        "VT323",
        "ui-monospace",
        "monospace"
      ],
      "$description": "The only typeface. A 16px dot-matrix bitmap face."
    }
  },
  "fontSize": {
    "label": {
      "$type": "dimension",
      "$value": "12px"
    },
    "body": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lead": {
      "$type": "dimension",
      "$value": "20px"
    },
    "h": {
      "$type": "dimension",
      "$value": "32px"
    },
    "readout": {
      "$type": "dimension",
      "$value": "48px"
    },
    "display": {
      "$type": "dimension",
      "$value": "64px"
    },
    "hero": {
      "$type": "dimension",
      "$value": "96px"
    }
  },
  "radius": {
    "tile": {
      "$type": "dimension",
      "$value": "24px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "$description": "The only two radii."
  },
  "dot": {
    "size": {
      "$type": "dimension",
      "$value": "6px"
    },
    "gap": {
      "$type": "dimension",
      "$value": "3px"
    }
  },
  "space": {
    "pad": {
      "$type": "dimension",
      "$value": "24px"
    },
    "grid-gap": {
      "$type": "dimension",
      "$value": "16px"
    },
    "page": {
      "$type": "dimension",
      "$value": "1200px"
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none"
    }
  },
  "motion": {
    "fast": {
      "$type": "duration",
      "$value": "160ms"
    },
    "base": {
      "$type": "duration",
      "$value": "320ms"
    },
    "slow": {
      "$type": "duration",
      "$value": "640ms"
    }
  }
}
