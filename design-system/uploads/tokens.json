{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Wishbone Golf v2 'Telemetry' tokens, 2026-09-19. Rebrand of the v1 as-found system; volt retained as the sole accent by owner decision.",
  "color": {
    "carbon": {
      "$type": "color",
      "$value": "#0F1014",
      "$description": "Page ground. Warm near-black."
    },
    "card": {
      "$type": "color",
      "$value": "#16171B"
    },
    "raised": {
      "$type": "color",
      "$value": "#1E2026",
      "$description": "Inputs, wells, hover surfaces."
    },
    "volt": {
      "$type": "color",
      "$value": "#E3FC02",
      "$description": "The only accent. Always carries carbon type."
    },
    "white": {
      "$type": "color",
      "$value": "#FAFAFA"
    },
    "muted": {
      "$type": "color",
      "$value": "#8E9298"
    },
    "light-warm": {
      "$type": "color",
      "$value": "#F2D2AB",
      "$description": "Lighting value for photography and washes \u2014 never a UI fill."
    },
    "error": {
      "$type": "color",
      "$value": "#FF6B6B",
      "$description": "Errors only. Never a second accent."
    }
  },
  "retired": {
    "cyan": {
      "$value": "#00FCED",
      "$description": "Retired in v2 \u2014 Ride-theme leftover, never used on the storefront."
    },
    "logo-lime": {
      "$value": "#C8D645",
      "$description": "Retired in v2 \u2014 monogram reissued in volt."
    },
    "ink": {
      "$value": "#1F1F21",
      "$description": "v1 ground, replaced by carbon."
    }
  },
  "font": {
    "display": {
      "$type": "fontFamily",
      "$value": [
        "Space Grotesk",
        "-apple-system",
        "sans-serif"
      ],
      "$description": "Replaces Oswald."
    },
    "body": {
      "$type": "fontFamily",
      "$value": [
        "Figtree",
        "-apple-system",
        "sans-serif"
      ]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": [
        "Share Tech Mono",
        "ui-monospace",
        "monospace"
      ],
      "$description": "Labels, numerals, any reported value."
    }
  },
  "fontSize": {
    "display": {
      "$type": "dimension",
      "$value": "68px"
    },
    "h1": {
      "$type": "dimension",
      "$value": "48px"
    },
    "h2": {
      "$type": "dimension",
      "$value": "32px"
    },
    "h3": {
      "$type": "dimension",
      "$value": "23px"
    },
    "h4": {
      "$type": "dimension",
      "$value": "18px"
    },
    "body": {
      "$type": "dimension",
      "$value": "15px"
    },
    "small": {
      "$type": "dimension",
      "$value": "13px"
    },
    "label": {
      "$type": "dimension",
      "$value": "11px"
    },
    "readout": {
      "$type": "dimension",
      "$value": "44px"
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "20px"
    },
    "control": {
      "$type": "dimension",
      "$value": "10px"
    },
    "media": {
      "$type": "dimension",
      "$value": "16px"
    },
    "chip": {
      "$type": "dimension",
      "$value": "8px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none",
      "$description": "Unchanged from v1 \u2014 the brand still casts no shadows."
    }
  },
  "space": {
    "page-width": {
      "$type": "dimension",
      "$value": "1440px"
    },
    "section": {
      "$type": "dimension",
      "$value": "72px"
    },
    "grid-gap": {
      "$type": "dimension",
      "$value": "20px"
    }
  },
  "dot": {
    "size": {
      "$type": "dimension",
      "$value": "5px"
    },
    "gap": {
      "$type": "dimension",
      "$value": "3px"
    },
    "$description": "The signature device. Data, charts and product silhouettes are drawn as dot grids."
  }
}
